# Example environment variables for local development.
#
# Copy this file to `.env` and fill in real values.
# Never commit your real `.env` (it contains secrets).

FLASK_ENV=development
FLASK_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=

# Giphy
GIPHY_API_KEY=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROVIDER_AUTHENTICATION_SECRET=

# Auth session timeout
AUTH_IDLE_TIMEOUT_MINUTES=45
AUTH_ABSOLUTE_TIMEOUT_HOURS=0

# Azure Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=

# Login audit storage (Azure Table Storage)
AZURE_LOGIN_AUDIT_TABLE=LoginAudit

# Newsletter / email
NEWSLETTER_EMAIL=
NEWSLETTER_PASSWORD=
SMTP_SERVER=
SMTP_PORT=587

# Cloudmersive
CLOUDMERSIVE_API_KEY=

# Stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PAYMENTLINK_TRIAL_14D=
STRIPE_PAYMENTLINK_MONTHLY_10_95=
STRIPE_PAYMENTLINK_ANNUAL_6_95=
STRIPE_PRICE_MONTHLY_10_95=
STRIPE_PRICE_TRIAL_FEE_1_85=
STRIPE_PRICE_ANNUAL_6_95=
STRIPE_COUPON_RETENTION=
STRIPE_PROMO_CODE_RETENTION=