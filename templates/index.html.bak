    <!-- main-content start -->
    <main class="main-content">

        <!-- templates showcase start -->
        <section class="templates-showcase">
            <div class="container">

                <div class="section-title">
                    <h6><span><img src="static/images/resume-01.png" alt="">Resume Templates</span></h6>
                    <h2>Professional Templates That Will <span>Get You Hired</span></h2>
                    <p>Choose from ATS-friendly designs crafted for every industry. Pick a layout, fill in your details,
                        and download a polished resume in minutes.</p>
                </div>

                <div class="templates-showcase__viewport">
                    <button type="button" class="templates-showcase__nav templates-showcase__nav--prev"
                        aria-label="Previous template">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="templates-showcase__track" id="templatesTrack" role="list"
                        aria-label="Resume templates">
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Professional</h3>
                                <p>Business · ATS-friendly</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/professional.jpg" alt="Professional resume template"
                                    loading="lazy" decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Bold Professional</h3>
                                <p>Business · Stand out</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/BoldProfessional.jpg" alt="Bold Professional resume template"
                                    loading="lazy" decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Contemporary</h3>
                                <p>Traditional · Versatile</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/traditional.jpg" alt="Contemporary resume template"
                                    loading="lazy" decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Modern</h3>
                                <p>Tech · Sleek layout</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/modern.jpg" alt="Modern resume template" loading="lazy"
                                    decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Stylish</h3>
                                <p>Design · Two-column</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/stylish.jpg" alt="Stylish resume template" loading="lazy"
                                    decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Creative</h3>
                                <p>Creative · Eye-catching</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/creative.jpg" alt="Creative resume template" loading="lazy"
                                    decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/get-started" class="templates-showcase__card" role="listitem">
                            <div class="templates-showcase__header">
                                <h3>Classic</h3>
                                <p>Timeless · Elegant</p>
                            </div>
                            <div class="templates-showcase__preview">
                                <img src="static/images/classic.jpg" alt="Classic resume template" loading="lazy"
                                    decoding="async">
                            </div>
                            <span class="templates-showcase__action">Use this template <i
                                    class="fas fa-arrow-right"></i></span>
                        </a>
                    </div>

                    <button type="button" class="templates-showcase__nav templates-showcase__nav--next"
                        aria-label="Next template">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>

            </div>
        </section>
        <!-- templates showcase end -->

        <!-- resume start -->
        <section class="resume">
            <div class="container">

                <div class="section-title">
                    <h6><span><img src="static/images/resume-01.png" alt="">Powerful Features</span></h6>
                    <h2>Everything You Need to Build a<br> Winning <span>Resume</span></h2>
                    <p>Powerful AI features designed to enhance your resume, optimize keywords for ATS systems, and
                        analyze your impact to help you stand out to recruiters.</p>
                </div>

                <div class="resume__wrapper">

                    <div class="resume__item">
                        <img src="static/images/resume-02.png" alt="">
                        <h2>Smart Enhancement</h2>
                        <p>Smart Enhancement Resumatic AI intelligently rewrites your resume bullet points using action
                            verbs, quantifiable achievements, and crisp phrasing, all tailored to your industry. It
                            highlights what matters and cuts what doesn't.</p>
                    </div>

                    <div class="resume__item">
                        <img src="static/images/resume-03.png" alt="">
                        <h2>Keyword Optimization</h2>
                        <p>We optimize your resume using relevant industry keywords and align it with common roles. When
                            a job description is provided, we further tailor the content to match its language and
                            priorities—helping your resume pass ATS and stand out to employers.</p>
                    </div>

                    <div class="resume__item">
                        <img src="static/images/resume-04.png" alt="">
                        <h2>Impact Analysis</h2>
                        <p>See your resume through an employer's eyes. We break down how your content scores in clarity,
                            strength, and alignment with job expectations, empowering you with actionable insights.</p>
                    </div>

                </div>
            </div>
        </section>
        <!-- resume end -->

        <!-- dashboard start -->
        <section class="dashboard">
            <div class="container">

                <div class="section-title">
                    <h6>
                        <span>
                            <img src="static/images/resume-01.png" alt="">
                            Career Dashboard
                        </span>
                    </h6>

                    <h2>
                        Track Every <span>Application</span> in One Place
                    </h2>

                    <p>
                        Your Career Dashboard keeps every job you apply to organized—from the company and role
                        to your resume version and application status. Add a position in seconds and never lose
                        track of where you stand in your search.
                    </p>
                </div>

                <div class="dashboard__features">
                    <div class="dashboard__feature">
                        <i class="fas fa-plus-circle"></i>
                        <div>
                            <h3>Add Applications Fast</h3>
                            <p>Log a new role with the company, position title, and status in just a few clicks.</p>
                        </div>
                    </div>
                    <div class="dashboard__feature">
                        <i class="fas fa-list-check"></i>
                        <div>
                            <h3>Stay on Top of Every Stage</h3>
                            <p>See at a glance which applications are applied, interviewing, or awaiting a response.</p>
                        </div>
                    </div>
                    <div class="dashboard__feature">
                        <i class="fas fa-file-lines"></i>
                        <div>
                            <h3>Link Resumes to Roles</h3>
                            <p>Connect each application to the tailored resume you used, so you're always prepared.</p>
                        </div>
                    </div>
                </div>

                <div class="dashboard__video">
                    <video id="myVideo" autoplay loop muted playsinline>
                        <source src="/static/videos/intro.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>

                <div class="dashboard__cta text-center">
                    <a href="/my_revisions" class="dashboard__btn">
                        Open Your Career Dashboard
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

            </div>
        </section>
        <!-- dashboard end -->

        <!-- work start -->
        <section class="work" id="how-it-works">
            <div class="container">
                <div class="section-title">
                    <h6><span><img src="static/images/resume-01.png" alt="">Our Process</span></h6>
                    <h2>How it <span>Works</span></h2>
                </div>
                <div class="work__item">
                    <div class="work__item-content">
                        <span>1</span>
                        <h2>Provide Your Resume</h2>
                        <p>Simply upload your resume file or paste the text content. Our system supports PDF, DOC, and
                            DOCX formats.</p>
                    </div>
                    <div class="work__item-image">
                        <img src="static/images/work-01.png" alt="">
                    </div>
                    <div class="work__item-image d-none d-md-block">
                        <img src="static/images/work-02.png" alt="">
                    </div>
                    <div class="work__item-content">
                        <span>2</span>
                        <h2>AI Enhancement</h2>
                        <p>Our advanced AI analyzes your content, improves language, adds impactful keywords, and
                            optimizes structure.</p>
                    </div>
                    <div class="work__item-image d-md-none">
                        <img src="static/images/work-02.png" alt="">
                    </div>
                    <div class="work__item-content">
                        <span>3</span>
                        <h2>Get Results</h2>
                        <p>Receive your enhanced resume with detailed analysis, improvement suggestions, and ATS
                            optimization and choose from various templates available.</p>
                    </div>
                    <div class="work__item-image">
                        <img src="static/images/work-03.webp" alt="">
                    </div>
                </div>
            </div>
        </section>
        <!-- work end -->

        <section class="review">
            <div class="container">

                <div class="section-title">
                    <h6>
                        <span>
                            <img src="static/images/resume-01.png" alt="">
                            Testimonials
                        </span>
                    </h6>

                    <h2>
                        What Our <span>Users</span> Say
                    </h2>

                    <p>
                        Join thousands of professionals building stronger resumes with AI.
                    </p>
                </div>

                <div class="review__wrapper">

                    <div class="review__item">
                        <p>Super helpful for making my resume look more professional in minutes.</p>
                        <div class="review__user">
                            <img src="static/images/review-01.png" alt="">
                            <div>
                                <h4>Arthur Lopez</h4>
                                <span>UI Designer</span>
                            </div>
                        </div>
                    </div>

                    <div class="review__item">
                        <p>I didn't know where to start, but this made the entire process easier.</p>
                        <div class="review__user">
                            <img src="static/images/review-02.png" alt="">
                            <div>
                                <h4>Jay Thomas</h4>
                                <span>Marketing Lead</span>
                            </div>
                        </div>
                    </div>

                    <div class="review__item">
                        <p>It transformed my basic resume into something I felt confident submitting.</p>
                        <div class="review__user">
                            <img src="static/images/review-03.png" alt="">
                            <div>
                                <h4>Emily Roger</h4>
                                <span>Software Engineer</span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </section>


        <!-- blog start -->
        <section class="blog">
            <div class="container">
                <div class="section-title">
                    <h6><span><img src="static/images/resume-01.png" alt="">Blogs & Resources</span></h6>
                    <h2>Resume <span>Tips and Career</span> Resources</h2>
                    <p>Expert advice and proven strategies to boost your job search, improve your resume, and land
                        interviews faster in today's competitive market.</p>
                </div>
                <div class="blog__wrapper">
