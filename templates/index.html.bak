    <!-- Meta setup -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="keywords"
        content="resume, resume builder, resume enhancement, AI resume, ATS optimization, job search, career development, resume templates, resume tips, resume writing, job application, interview preparation, resume analysis, resume feedback, resume improvement, resume formatting, resume keywords, resume optimization, free resume tool, professional resume, job-winning resume, resume writing service, resume review, resume critique, resume suggestions, resume improvement tool, resume builder online, resume generator, resume assistant, resume help, resume advice, resume tips and tricks, resume best practices">
    <meta name="description"
        content="Build a job-winning resume with AI. Instant enhancements, ATS optimization, and professional formatting.">

    <!-- Title -->
    <title>ResumaticAI</title>

    <!-- Fav Icon -->
    <link rel="icon" href="static/images/favicon2.ico" />

    <!-- Include Bootstrap -->
    <link rel="stylesheet" href="static/css/bootstrap.css" />

    <!-- Include font-awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
