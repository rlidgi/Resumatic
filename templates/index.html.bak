    <!-- Scroll-Top button -->
    <a href="#" class="scrolltotop">
        <i class="fas fa-arrow-up" aria-hidden="true"></i>
        <span class="pluse"></span>
        <span class="pluse2"></span>
    </a>
    <script>

        const video = document.getElementById("myVideo");
        if (video) {
            video.playbackRate = 2.0;
            video.addEventListener("play", () => {
                video.playbackRate = 2.0;
            });
        }

        (function () {
            const track = document.getElementById('templatesTrack');
            const prevBtn = document.querySelector('.templates-showcase__nav--prev');
            const nextBtn = document.querySelector('.templates-showcase__nav--next');
            if (!track || !prevBtn || !nextBtn) return;

            const CARD_COUNT = 7;
            const MIDDLE_START = CARD_COUNT;

            const originals = Array.from(track.querySelectorAll('.templates-showcase__card'));
            if (!originals.length) return;

            originals.forEach((card) => {
                const clone = card.cloneNode(true);
                clone.setAttribute('aria-hidden', 'true');
                clone.removeAttribute('role');
                track.appendChild(clone);
            });

            [...originals].reverse().forEach((card) => {
                const clone = card.cloneNode(true);
                clone.setAttribute('aria-hidden', 'true');
                clone.removeAttribute('role');
                track.insertBefore(clone, track.firstChild);
            });

            const gap = () => parseFloat(getComputedStyle(track).gap) || 24;
            const step = () => originals[0].offsetWidth + gap();
            const physicalPos = (index) => index * step();
            const TRANSITION_MS = 450;
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            let physicalIndex = MIDDLE_START;
            let logicalIndex = 0;
            let isTransitioning = false;

            const setPosition = (index, animate) => {
                const shouldAnimate = animate && !prefersReducedMotion;
                track.style.transition = shouldAnimate
                    ? `transform ${TRANSITION_MS}ms cubic-bezier(0.4, 0, 0.2, 1)`
                    : 'none';
                track.style.transform = `translate3d(${-physicalPos(index)}px, 0, 0)`;
            };

            const waitForTransition = () => new Promise((resolve) => {
                if (!track.style.transition || track.style.transition === 'none') {
                    resolve();
                    return;
                }

                let finished = false;
                const done = () => {
                    if (finished) return;
                    finished = true;
                    track.removeEventListener('transitionend', onEnd);
                    resolve();
                };

                const onEnd = (event) => {
                    if (event.target !== track || event.propertyName !== 'transform') return;
                    done();
                };

                track.addEventListener('transitionend', onEnd);
                setTimeout(done, TRANSITION_MS + 80);
            });

            const init = () => {
                logicalIndex = 0;
                physicalIndex = MIDDLE_START;
                setPosition(physicalIndex, false);
            };

            nextBtn.addEventListener('click', async () => {
                if (isTransitioning) return;
                isTransitioning = true;

                physicalIndex += 1;
                logicalIndex = (logicalIndex + 1) % CARD_COUNT;
                setPosition(physicalIndex, true);
                await waitForTransition();

                if (physicalIndex >= MIDDLE_START + CARD_COUNT) {
                    physicalIndex = MIDDLE_START + logicalIndex;
                    setPosition(physicalIndex, false);
                }

                isTransitioning = false;
            });

            prevBtn.addEventListener('click', async () => {
                if (isTransitioning) return;
                isTransitioning = true;

                physicalIndex -= 1;
                logicalIndex = (logicalIndex - 1 + CARD_COUNT) % CARD_COUNT;
                setPosition(physicalIndex, true);
                await waitForTransition();

                if (physicalIndex < MIDDLE_START) {
                    physicalIndex = MIDDLE_START + logicalIndex;
                    setPosition(physicalIndex, false);
                }

                isTransitioning = false;
            });

            window.addEventListener('resize', () => {
                setPosition(physicalIndex, false);
            });

            init();
        })();

    </script>

</body>

