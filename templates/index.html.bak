                            </li>
                        </ul>
                    </div>
                    <div class="header__right d-none d-lg-block">
                        <ul>
                            {% if user and user.is_authenticated %}
                            <li>
                                <a href="/my_revisions">My Account</a>
                            </li>
                            <li>
                                <a href="/logout" class="active">Logout</a>
                            </li>
                            {% else %}
                            <li>
                                <a href="/my_revisions">Login</a>
                            </li>
                            <li>
                                <a href="/login?tab=register" class="active">Sign Up</a>
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                    <div class="header__hamburger d-lg-none" data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvasExample" aria-controls="offcanvasExample"
                        aria-label="Toggle navigation">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </nav>
            </div>
        </header>
        <!-- header end -->

        <!-- hero start -->
        <section class="hero">
            <div class="container">
                <div class="hero__item hero__item--split">
                    <div class="hero__top">
                        <div class="hero__content">
                            <h2>Elevate Your <span>Resume</span> <br>with AI</h2>
                            <p>Try our easy to use AI resume builder for instant enhancements and ATS<br> optimization,
                                and
                                stand out in today's competitive job market.</p>
                            <div class="faq__bottom p-0">
                                <a href="/get-started">Get Started <img src="static/images/hero-03.png" alt=""></a>
                            </div>
                        </div>

                        <div class="hero-animation-container">
                            <div class="animation-scene scene-delay-0">
                                <img src="/static/images/animation/resume-preview1_back.png" alt="Resume Template"
                                    class="layer-bg">
                                <img src="/static/images/animation/resume-preview1.png" alt="Floating Element"
                                    class="layer-fg">
                            </div>

                            <div class="animation-scene scene-delay-1">
                                <img src="/static/images/animation/resume-preview2_back.png" alt="Resume Template"
                                    class="layer-bg">
                                <img src="/static/images/animation/resume-preview2.png" alt="Floating Element"
                                    class="layer-fg">
                            </div>

                            <div class="animation-scene scene-delay-2">
                                <img src="/static/images/animation/resume-preview3_back.png" alt="Resume Template"
                                    class="layer-bg">
                                <img src="/static/images/animation/resume-preview3.png" alt="Floating Element"
                                    class="layer-fg">
                            </div>
                        </div>
                    </div>

                    <div class="hero__item-image">
                        <img src="static/images/hero-01.png" alt="">
                    </div>
                </div>
            </div>
        </section>
        <!-- hero end -->

    </div>

    <!-- offcanvas start -->
