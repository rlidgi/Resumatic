    <div class="hero__wrapper">

        <!-- header start -->
        <header class="header">
            <div class="container">
                <nav class="header__nav">
                    <div class="header__logo">
                        <a href="#">
                            <img src="static/images/logo.svg" alt="Logo">
                        </a>
                    </div>
                    <div class="header__menu d-none d-lg-block">
                        <ul>
                            <li>
                                <a class="active" href="#">Home</a>
                            </li>
                            <li>
