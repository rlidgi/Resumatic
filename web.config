<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- URL Rewrite: Redirect 100percentresumes.com -> resumaticai.com -->
    <rewrite>
      <rules>
        <!-- 1) Redirect any request for 100percentresumes.com (http or https) to resumaticai.com -->
        <rule name="100percentresumes to Primary Redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{HTTP_HOST}" pattern="^(100percentresumes\.com|www\.100percentresumes\.com)$" />
          </conditions>
          <action type="Redirect" url="https://resumaticai.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- (Optional) If you also want to canonicalize www.resumaticai.com to resumaticai.com -->
        <!--
        <rule name="WWW to Apex (Primary Domain)" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.resumaticai\.com$" />
          </conditions>
          <action type="Redirect" url="https://resumaticai.com/{R:1}" redirectType="Permanent" />
        </rule>
        -->

        <!-- 2) Force HTTPS for anything else that reaches here -->
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Python Configuration -->
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="FastCgiModule" scriptProcessor="%PYTHONHOME%\python.exe|%PYTHONHOME%\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <!-- Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Robots-Tag" value="index, follow" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!--
    IMPORTANT CACHING NOTES

    - The React SPA shell (index.html) must NOT be cached. If a client (or proxy) serves a stale index.html,
      it may reference hashed JS/CSS files that no longer exist after a deploy, leading to an unstyled/
      "skeleton" experience.
    - Hashed assets under /static/react/assets/ ARE safe to cache aggressively.
  -->

  <!-- React SPA routes served by the Python app: never cache -->
  <location path="react">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
          <remove name="Pragma" />
          <add name="Pragma" value="no-cache" />
          <remove name="Expires" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- If index.html is ever served as a static file, never cache it -->
  <location path="static/react/index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
          <remove name="Pragma" />
          <add name="Pragma" value="no-cache" />
          <remove name="Expires" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Hashed assets: cache long-lived -->
  <location path="static/react/assets">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <appSettings>
    <add key="PYTHONPATH" value="D:\home\site\wwwroot" />
    <add key="WSGI_HANDLER" value="app.app" />
  </appSettings>
</configuration>
